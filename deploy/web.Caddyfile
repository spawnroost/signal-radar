# Static server inside the web image. TLS and the security headers live in the edge Caddy
# (deploy/Caddyfile.snippet); this one only serves files and sets cache rules.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	# Hashed build output and static art never change under the same URL.
	@immutable path /assets/* /icons/* /marketing/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	# Everything else always revalidates: index.html, the pre-rendered pages, sw.js, push-sw.js,
	# workbox-*.js and manifest.webmanifest, where a stale copy would pin an old build.
	@revalidate not path /assets/* /icons/* /marketing/*
	header @revalidate Cache-Control "no-cache"

	# Pre-rendered pages (/pricing, /terms, ...) are directories with an index.html; any other
	# path is a client-side route and gets the SPA shell.
	try_files {path} {path}/index.html /index.html
	file_server
}
