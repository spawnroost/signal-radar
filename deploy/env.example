# Signal Radar production env. Copy to /opt/signalradar/.env on the server (chmod 600) and fill in.
# [secret] values must never be committed. Empty optional values switch that feature off.
# Used by compose.yml via `docker compose --env-file .env`.

# --- project ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=signalradar
# Network alias prefix the edge Caddy uses (<prefix>-api, <prefix>-web). A staging copy on the same box: signalradar-staging.
EDGE_ALIAS=signalradar
TZ=UTC
# Set by ship.sh to the image tag being deployed; used for rollback.
IMAGE_TAG=local

# --- public URLs (production values) --------------------------------------------------
BETTER_AUTH_URL=https://signalradar.spawnroost.com
WEB_ORIGIN=https://signalradar.spawnroost.com
# Baked into the web build (canonical/Open Graph URLs, sitemap, robots). Build-time: ship.sh reads it.
VITE_SITE_URL=https://signalradar.spawnroost.com

# --- database ----------------------------------------------------------------------------
# [secret] Used inside a postgres:// URL, so keep it URL-safe (hex): openssl rand -hex 24
POSTGRES_PASSWORD=

# --- auth [secret] ------------------------------------------------------------------------
# 32+ characters: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Optional social sign-in. Each pair turns its button on; with either on, email+password is off in production.
# Google callback: https://signalradar.spawnroost.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub callback: https://signalradar.spawnroost.com/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Dodo Payments (one-time passes). Unset = checkout closed. API key: dashboard > Developer > API Keys.
# Webhook key: signing secret of the webhook for https://<site>/api/billing/dodo/webhook. Product ids differ per mode.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRODUCT_30=
DODO_PRODUCT_90=
DODO_PRODUCT_365=

# --- SHELVED: Razorpay prepaid passes (not used; payments go through Dodo Payments). Leave empty. The compose file
# does not pass these to the API container, so they cannot take effect in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Comma-separated login emails allowed to view payments (/admin).
ADMIN_EMAILS=
# Optional: override the admin Telegram chat (default: the chat the admin linked in Settings).
TELEGRAM_ADMIN_CHAT_ID=

# --- web push (Pro). Generate: pnpm --filter @radar/core exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Telegram (Pro). After first deploy run: radar telegram:webhook https://signalradar.spawnroost.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# --- radar pipeline (cron + summaries + search) ----------------------------------------
# Scorer/summaries: radar.config.ts picks 'deepseek' (DEEPSEEK_API_KEY) or 'anthropic' (ANTHROPIC_API_KEY).
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# Lifts the GitHub search rate limit (403 when unauthenticated).
GITHUB_TOKEN=
# YouTube Data API v3 key (server-side). Unset = YouTube left out of search.
YOUTUBE_API_KEY=

# --- schedule (UTC) and backups --------------------------------------------------------
RADAR_AT=03:00 15:00
REMIND_AT=09:00
BACKUP_AT=02:00
BACKUP_KEEP=14
# Optional offsite copy of the nightly dump (Cloudflare R2). Unset = local volume only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=

# --- loopback ports on the server (127.0.0.1 only; pick others if they clash) ----------
HOST_API_PORT=18787
HOST_WEB_PORT=18080
HOST_DB_PORT=15432
