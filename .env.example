# --- radar pipeline ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DEEPSEEK_API_KEY=
NOTION_TOKEN=

# --- database / api ---
DATABASE_URL=postgres://radar:radar@localhost:5432/radar
TEST_DATABASE_URL=postgres://radar:radar@localhost:5432/radar_test
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-32chars-min
BETTER_AUTH_URL=http://localhost:8787
WEB_ORIGIN=http://localhost:5173
# Optional social sign-in. Each is on only when both of its values are set. With neither set,
# email + password is the sign-in; with either set, email + password is off in production.
# Google: OAuth client from Google Cloud Console; authorized redirect URI:
# <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: OAuth App from GitHub Developer settings; authorization callback URL:
# <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
API_PORT=8787

# --- SHELVED: Razorpay prepaid passes (not used; payments go through Dodo Payments). Leave empty. The compose file
# does not pass these to the API container, so they cannot take effect in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Comma-separated login emails allowed to view payments (/admin).
ADMIN_EMAILS=
# Optional: override the admin Telegram chat (default: the chat the admin linked in Settings).
TELEGRAM_ADMIN_CHAT_ID=

# --- web push (Pro). Unset = push disabled. Generate: pnpm --filter @radar/core exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- telegram connect (Pro). Unset = Connect Telegram hidden. Webhook: radar telegram:webhook <publicBaseUrl>
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# --- web build. Public origin of the web app, used for canonical/Open Graph URLs, sitemap.xml and robots.txt.
VITE_SITE_URL=http://localhost:5173

# --- YouTube in search. Unset = YouTube left out. Google Cloud Console: enable "YouTube Data API v3", create an API key restricted to that API. Server-side only; free tier is about 100 searches a day.
YOUTUBE_API_KEY=

# Dodo Payments
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRODUCT_30=pdt_0NsCPFRsnpRSmLKfirRiX
DODO_PRODUCT_90=pdt_0NsCPFU74tpvGiWaZgA1T
DODO_PRODUCT_365=pdt_0NsCPFWS6Jw0gyUrwfhuE
